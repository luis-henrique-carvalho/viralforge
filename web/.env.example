# ==============================================================================
# ViralForge Web — Variáveis de Ambiente
# ==============================================================================

# URL Base da API do Backend consumida no client
VITE_API_BASE_URL=/api

# Destino do Proxy do Vite para Backend local / Docker
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Título da Aplicação
VITE_APP_TITLE=ViralForge

# Habilitar DevTools (TanStack Router & Query) em desenvolvimento
VITE_ENABLE_DEVTOOLS=true
