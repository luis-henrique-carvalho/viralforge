# ==============================================================================
# ViralForge Web — Variáveis de Ambiente
# ==============================================================================

# URL Base da API do Backend
# No ambiente local de desenvolvimento, o Vite usa o proxy configurado em vite.config.ts para /api -> http://localhost:8000
VITE_API_BASE_URL=/api

# Título da Aplicação
VITE_APP_TITLE=ViralForge

# Habilitar DevTools (TanStack Router & Query) em desenvolvimento
VITE_ENABLE_DEVTOOLS=true
